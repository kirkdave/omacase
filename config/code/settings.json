{
    "chat.viewSessions.orientation": "stacked",
    "editor.fontSize": 13,
    "editor.fontFamily": "DMMonoNerdFontComplete-Light, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontWeight": "normal",
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.55,
    "workbench.colorTheme": "Catppuccin Mocha",
    "catppuccin.accentColor": "sky",
    "workbench.sideBar.location": "right",
    "terminal.integrated.fontFamily": "DMMonoNerdFontComplete-Light, Menlo, Monaco, 'Courier New', monospace",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.fontWeight": "normal",
    "editor.bracketPairColorization.enabled": true,
    "editor.cursorBlinking": "expand",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.guides.bracketPairs": true,
    "editor.guides.highlightActiveIndentation": true,
    "editor.minimap.enabled": false,
    "editor.tabSize": 4,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "window.zoomLevel": 0.75,
    "workbench.startupEditor": "none",
    "workbench.tree.indent": 24,
    "workbench.tree.renderIndentGuides": "always",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

}
