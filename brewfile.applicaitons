# Handle corporate proxies and firewalls
custom_ca_file_path = "#{ENV['HOME']}/.custom-ca-certificates.pem"

if File.exist? 	custom_ca_file_path
	ENV["NODE_EXTRA_CA_CERTS"] = custom_ca_file_path
	ENV["SSL_CERT_FILE"] = custom_ca_file_path
end

# Applications
cask "docker-desktop"
cask "ghostty"
cask "raycast"
cask "nikitabobko/tap/aerospace", trusted: true
cask "visual-studio-code"
cask "drawio"

# Fonts

cask "font-dm-mono"
cask "font-dm-sans"
cask "font-dm-serif-display"
cask "font-dm-serif-text"
cask "font-jetbrains-mono-nerd-font"
cask "kirkdave/custom-formulas/font-dm-mono-nerd", trusted: true
cask "kirkdave/custom-formulas/font-modernline-personal", trusted: true

# VS Code
vscode "catppuccin.catppuccin-vsc"
vscode "42crunch.vscode-openapi"
vscode "davidanson.vscode-markdownlint"

